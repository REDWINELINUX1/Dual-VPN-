#!/usr/bin/env bash
set -euo pipefail

if [[ "${1:-}" != "run" ]]; then
  echo "Usage: ./sing-box run -c <config>" >&2
  exit 2
fi

shift || true

if [[ "${1:-}" != "-c" ]]; then
  echo "Missing -c flag" >&2
  exit 2
fi

config_file="${2:-}"
if [[ -z "${config_file}" ]]; then
  echo "Missing config path" >&2
  exit 2
fi

printf '[sing-box] running with config: %s\n' "$config_file"
if [[ ! -f "${config_file}" ]]; then
  printf '[sing-box] config file not found: %s\n' "${config_file}" >&2
  exit 1
fi

printf '[sing-box] no sing-box core is installed; this wrapper cannot run a VPN.\n' >&2
exit 127
